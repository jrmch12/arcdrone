<mujoco model="Skydio X2 scene mounted camera">

  <include file="./common/skybox.xml"/>
  <include file="./common/visual.xml"/>
  <include file="./common/materials.xml"/>
  <include file="x2.xml"/>

  <statistic center="0 0 0.1" extent="0.7" meansize=".05"/>

  <asset>
    <material name="landing_ring_outer" rgba="1 1 1 1" emission="0.6"/>
    <material name="landing_ring_inner" rgba="0.15 0.15 0.15 1" emission="0.2"/>
    <material name="landing_ring_center" rgba="1 0 0 1" emission="0.8"/>
    <mesh name="scene_collision" file="../../gs/mesh_collision_final.obj" scale="1 1 1"/>
  </asset>

  <worldbody>

    <light name="ambient" pos="0 0 10"
      ambient="0.62 0.62 0.62"
      diffuse="0.62 0.62 0.62"
      specular="0.1 0.1 0.1"
      directional="true"
      castshadow="false"/>

    <light name="key" pos="2 -2 6"
      ambient="0.28 0.28 0.28"
      diffuse="0.85 0.85 0.85"
      specular="0.2 0.2 0.2"/>

    <light name="fill" pos="-2 2 4"
      ambient="0.2 0.2 0.2"
      diffuse="0.45 0.45 0.45"
      castshadow="false"/>

    <body name="origin_target" pos="0 0 0"/>

    <!-- Scene collision mesh (from 3DGS scene — physics only, not rendered by GS) -->
    <geom name="scene_collision" type="mesh" mesh="scene_collision"
          group="3" contype="1" conaffinity="1" mass="0"
          rgba="0.5 0.5 0.5 0.3"/>

    <!-- Floor: fallback collision plane beneath the scene mesh -->
    <geom name="floor" type="plane" size="0 0 0.05" pos="0 0 -1" contype="1" conaffinity="1"/>

    <geom
      name="landing_ring_outer"
      type="cylinder"
      pos="0 0 0.001"
      size="1.2 0.001"
      material="landing_ring_outer"
      contype="0"
      conaffinity="0"/>

    <geom
      name="landing_ring_inner"
      type="cylinder"
      pos="0 0 0.002"
      size="0.6 0.001"
      material="landing_ring_inner"
      contype="0"
      conaffinity="0"/>

    <geom
      name="landing_ring_center"
      type="cylinder"
      pos="0 0 0.003"
      size="0.12 0.001"
      material="landing_ring_center"
      contype="0"
      conaffinity="0"/>

    <geom
      name="fiducial_plate"
      type="box"
      pos="0 0 0.0035"
      size="0.3 0.3 0.002"
      material="fiducial"
      contype="0"
      conaffinity="0"/>

  </worldbody>

</mujoco>
