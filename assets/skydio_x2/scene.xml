<mujoco model="Skydio X2 scene">

  <!-- Same shared assets as cartpole -->
  <include file="./common/skybox.xml"/>
  <include file="./common/visual.xml"/>
  <include file="./common/materials.xml"/>

  <include file="x2.xml"/>

  <statistic center="0 0 0.1" extent="0.6" meansize=".05"/>

  <worldbody>
    <!-- Same simple light style as cartpole -->
    <light name="light" pos="0 0 6"/>

    <body name="origin_target" pos="0 0 0"/>

    <!-- Cameras -->
    <camera name="outer_camera"      pos="-7 0 1" mode="targetbody" target="origin_target"/>
    <camera name="outer_camera_side" pos="0 -7 1" mode="targetbody" target="origin_target"/>
    <camera name="outer_camera_up"   pos="0 0 11" mode="targetbody" target="origin_target"/>

    <!-- Same floor style as cartpole -->
    <geom name="floor"
          type="plane"
          pos="0 0 -0.05"
          size="4 4 0.2"
          material="grid"/>

    <!-- Your fiducial marker -->
    <geom name="fiducial_plate"
          type="box"
          pos="0 0 0.002"
          size="0.3 0.3 0.002"
          rgba=".6 .3 .3 1"
          contype="0"
          conaffinity="0"/>

  </worldbody>

</mujoco>